{
  "name": "ipad-audit",
  "private": true,
  "description": "Remote condition check for used iPads, iPhones and Macs",
  "scripts": {
    "test": "node --test tests/seller_parse.test.js tests/example.test.js tests/docs.test.js tests/backend.test.js",
    "e2e": "playwright test",
    "gallery": "node scripts/build-flows-gallery.js",
    "flows": "playwright test; node scripts/build-flows-gallery.js",
    "watch": "PAUSE_MS=1600 SLOWMO=250 playwright test --headed --workers=1",
    "step": "STEP=1 playwright test --headed --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
